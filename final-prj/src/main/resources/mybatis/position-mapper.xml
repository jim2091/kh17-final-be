<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="mapper.position">

<!-- 직급 등록 -->
<select id="sequence" resultType="int">
	select position_seq.nextval from dual
</select>
<insert id="add">
	insert into position(
		position_no, position_name, position_block, position_info
	)
	values(
		#{positionNo}, #{positionName}, #{positionBlock}, #{positionInfo}
	)
</insert>

<!-- 직급 정보 조회 -->
<select id="find" resultType="positionDto">
	select * from position where position_no = #{positionNo}
</select>

</mapper>