<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="mapper.dept">

<!-- 부서 등록 -->
<select id="sequence" resultType="int">
	select dept_seq.nextval from dual
</select>
<insert id="add">
	insert into dept(
		dept_no, dept_name, dept_block, dept_info
	)
	values(
		#{deptNo}, #{deptName}, #{deptBlock}, #{deptInfo}
	)
</insert>

<!-- 부서 정보 조회 -->
<select id="find" resultType="deptDto">
	select * from dept where dept_no = #{deptNo}
</select>



</mapper>