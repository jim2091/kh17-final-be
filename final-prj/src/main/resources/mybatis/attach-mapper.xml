<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.attach">


    <!-- ===================================================== -->
    <!-- 시퀀스 번호 생성 -->
    <!-- ===================================================== -->

    <select id="sequence" resultType="int">

        select attach_seq.nextval
        from dual

    </select>


    <!-- ===================================================== -->
    <!-- 파일 정보 등록 -->
    <!-- ===================================================== -->

    <insert id="add">

        insert into attach(
            attach_no,
            attach_name,
            attach_type,
            attach_size,
            attach_uploader,
            attach_source
        )
        values(
            #{attachNo},
            #{attachName},
            #{attachType},
            #{attachSize},
            #{attachUploader},
            #{attachSource}
        )

    </insert>


    <!-- ===================================================== -->
    <!-- 단일 파일 조회 -->
    <!-- ===================================================== -->

    <select id="find"
            resultType="AttachDto">

        select
            *
        from attach
        where attach_no = #{attachNo}

    </select>


    <!-- ===================================================== -->
    <!-- 파일 삭제 -->
    <!-- ===================================================== -->

    <delete id="delete">

        delete from attach
        where attach_no = #{attachNo}

    </delete>


    <!-- ===================================================== -->
    <!-- 여러 개의 번호로 파일 목록 조회 -->
    <!-- ===================================================== -->

    <select id="findList"
            resultType="AttachDto">

        select
            *
        from attach
        where attach_no in(

            <foreach
                item="attachNo"
                collection="list"
                separator=","
            >
                #{attachNo}
            </foreach>

        )

        order by attach_no asc

    </select>


    <!-- ===================================================== -->
    <!-- 프로젝트별 파일 목록 -->
    <!-- ===================================================== -->

    <select id="selectListByProject"
            resultType="AttachDto">

        select
            a.*,
            e.emp_name as empName

        from project_file pf

        join attach a
            on pf.attach_no = a.attach_no

        left join emp e
            on a.attach_uploader = e.emp_no

        where pf.project_no = #{projectNo}

        order by a.attach_ctime desc

    </select>


    <!-- ===================================================== -->
    <!-- 프로젝트별 파일 검색 -->
    <!-- ===================================================== -->

    <select id="selectListByProjectAndKeyword"
            resultType="AttachDto">

        select
            a.*,
            e.emp_name as empName

        from project_file pf

        join attach a
            on pf.attach_no = a.attach_no

        left join emp e
            on a.attach_uploader = e.emp_no

        where pf.project_no = #{projectNo}

        and a.attach_name
            like '%' || #{keyword} || '%'

        order by a.attach_ctime desc

    </select>


</mapper>